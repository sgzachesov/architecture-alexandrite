        <mxCell id="note1" value="Инвалидация — после COMMIT: карточка заказа — DEL по ключу, список и счётчики — INCR версии. Старые ключи доживают TTL." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1045" width="690" height="40" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="TTL — страховка от потерянной инвалидации: карточка 5 мин, список и счётчики 45 с, справочники 1 ч." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="760" y="1045" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="Красным выделены новые операции кеширования. Redis недоступен → fallback в MES DB без потери данных." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
